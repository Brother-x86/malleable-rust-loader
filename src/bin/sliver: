fn fromfile_master_keypair(path_file: &str) -> Ed25519KeyPair {
    let pkcs8_bytes: Vec<u8> = fs::read(path_file).unwrap();
    signature::Ed25519KeyPair::from_pkcs8(pkcs8_bytes.as_ref()).unwrap()
}

